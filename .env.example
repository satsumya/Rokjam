# Supabase — copy to .env and fill in from Supabase dashboard → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# prototype (default) | production
# EXPO_PUBLIC_APP_MODE=prototype

# EAS Build (production + preview profiles) uses the same vars from EAS project
# environment settings — configure with: eas env:set production
